PORT=5000
NODE_ENV=development

MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_api_key

# Secure password-reset email delivery (Resend)
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Only for local classroom demo, never production or shared public servers:
# Requires NODE_ENV=development; exposes a reset code to the requester.
ALLOW_DEMO_RESET_TOKEN=false
