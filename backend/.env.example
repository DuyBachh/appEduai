PORT=5000
NODE_ENV=development

MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_api_key

# FR-03: demo reset directly in app, without sending email.
# Enable ONLY for trusted local classroom testing, NOT on Render/public.
# Requires NODE_ENV=development; returns reset token to app via API.
ALLOW_DEMO_RESET_TOKEN=false
